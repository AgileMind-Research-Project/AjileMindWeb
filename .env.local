# Platform Home & AgileMind Frontend - Environment Variables
# Copy from .env.example and customize

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://192.168.8.130:8000
NEXT_PUBLIC_API_VERSION=v1

# Platform URLs
NEXT_PUBLIC_PLATFORM_HOME_URL=http://localhost:3008
NEXT_PUBLIC_AGILEMIND_PLATFORM_URL=http://localhost:3008

# Application
NEXT_PUBLIC_APP_NAME=AgileMind
NEXT_PUBLIC_APP_VERSION=1.0.0

# Features
NEXT_PUBLIC_ENABLE_REGISTRATION=true
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=true

# Session
NEXT_PUBLIC_TOKEN_STORAGE_KEY=agilemind_access_token
NEXT_PUBLIC_REFRESH_TOKEN_STORAGE_KEY=agilemind_refresh_token
NEXT_PUBLIC_USER_STORAGE_KEY=agilemind_user
NEXT_PUBLIC_TENANT_STORAGE_KEY=agilemind_tenant
